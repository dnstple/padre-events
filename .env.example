# =============================================================================
# PADRE65 EVENTS — environment variables
# Copy to .env.local for development. NEVER commit .env.local.
# These are placeholders: no real credential belongs in this file.
# =============================================================================

# --- Google Sheets (the guest list) -----------------------------------------
# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your-spreadsheet-id

# Service account credentials. Google Cloud Console -> IAM -> Service Accounts
# -> Keys -> Add key -> JSON. Take these two fields out of the downloaded file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=padre65-events@your-project.iam.gserviceaccount.com

# The whole private_key value. In THIS FILE it needs the double quotes and the
# \n escapes. In the Vercel dashboard, paste it WITHOUT the surrounding quotes —
# a text box stores them as part of the value, and the key then fails to parse.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Optional. Defaults to "RSVPs" — the tab name inside the spreadsheet.
# GOOGLE_SHEET_TAB=RSVPs

# --- The popup page's own spreadsheet ----------------------------------------
# The popup at /popup captures a different shape of record from the house-party
# invitation — a name, one contact detail, and whether the visitor took the
# calendar file — so it writes to a separate document. Create an empty
# spreadsheet, share it with the service account above as Editor, and paste its
# ID (the part of the URL between /d/ and /edit) here. The app creates the tab
# and writes the header row itself.
GOOGLE_POPUP_SHEET_ID=your-popup-spreadsheet-id

# Optional. Defaults to "Signups" — the tab name inside that spreadsheet.
# GOOGLE_POPUP_SHEET_TAB=Signups

# --- Administrator access ----------------------------------------------------
# One shared password for the guest list at /admin. Use a long random string.
ADMIN_PASSWORD=choose-a-long-random-password

# Signs the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out.
ADMIN_SESSION_SECRET=generate-a-64-character-hex-string

# --- Site --------------------------------------------------------------------
# Canonical public origin. Used for metadata, Open Graph and the canonical URL.
NEXT_PUBLIC_SITE_URL=https://events.padre65.com
