# =============================================================================
# PADRE65 EVENTS — environment variables
# Copy to .env.local for development. NEVER commit .env.local.
# These are placeholders: no real credential belongs in this file.
# =============================================================================

# Supabase project URL. Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable "anon" key. Safe in the browser. Settings → API → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key. SERVER ONLY — this bypasses Row Level Security.
# Never prefix it with NEXT_PUBLIC_. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of email addresses permitted to view the guest list.
# Checked on every admin page load and every admin API request.
ADMIN_EMAILS=you@padre65.com,someone-else@padre65.com

# Canonical public origin. Used for metadata, Open Graph and the canonical URL.
NEXT_PUBLIC_SITE_URL=https://events.padre65.com
